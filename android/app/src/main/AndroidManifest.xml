<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_daily"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.label-files" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/label_files" /></provider>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:theme="@style/Theme.Habit" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".SetupActivity" android:exported="false" android:theme="@style/Theme.Habit.QuickLog" />
        <activity android:name=".ExerciseLogActivity" android:exported="false" android:theme="@style/Theme.Habit.QuickLog" android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".QuickLogActivity"
            android:exported="false"
            android:theme="@style/Theme.Habit.QuickLog"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <receiver
            android:name=".DailyWidgetReceiver"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_widget" />
        </receiver>
    </application>
</manifest>
